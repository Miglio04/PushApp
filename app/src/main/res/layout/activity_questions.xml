<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvStepCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/step_of"
        tools:text="Step 1 of 5"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="35dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvProgressPercentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/percent"
        tools:text="20%"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="35dp"
        android:layout_marginBottom="8dp"/>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_below="@id/tvStepCounter"
        android:progressDrawable="@drawable/bg_progress_bar"
        android:progress="20"
        android:max="100"
        android:layout_marginBottom="30dp"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/progressBar"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white">

        <ViewFlipper
            android:id="@+id/viewFlipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:minHeight="350dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/logo_pushapp"
                    android:contentDescription="@string/app_icon"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/great"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_primary"
                    android:layout_marginBottom="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_desc"
                    android:gravity="center"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_marginBottom="30dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_first_name"
                    android:textColor="@color/md_theme_onSurface"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"/>
                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/bg_input_outline"
                    android:hint="@string/hint_first_name"
                    android:paddingStart="20dp"
                    android:inputType="textPersonName"/>
                <TextView
                    android:id="@+id/tvNameError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/error_first_name_required"
                    android:textColor="#B00020"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginBottom="15dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_last_name"
                    android:textColor="@color/md_theme_onSurface"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"/>
                <EditText
                    android:id="@+id/etSurname"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/bg_input_outline"
                    android:hint="@string/hint_last_name"
                    android:paddingStart="20dp"
                    android:inputType="textPersonName"/>
                <TextView
                    android:id="@+id/tvSurnameError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/error_last_name_required"
                    android:textColor="#B00020"
                    android:textSize="12sp"
                    android:visibility="gone"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_gender"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_primary"
                    android:layout_marginBottom="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/desc_gender"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_marginBottom="30dp"/>

                <RadioGroup
                    android:id="@+id/radioGroupGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbMale"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="@string/gender_male"
                        android:paddingStart="15dp"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@null"
                        android:drawableRight="?android:attr/listChoiceIndicatorSingle"
                        android:layout_marginBottom="10dp"/>

                    <RadioButton
                        android:id="@+id/rbFemale"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="@string/gender_female"
                        android:paddingStart="15dp"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@null"
                        android:drawableRight="?android:attr/listChoiceIndicatorSingle"
                        android:layout_marginBottom="10dp"/>

                    <RadioButton
                        android:id="@+id/rbOther"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="@string/gender_other"
                        android:paddingStart="15dp"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@null"
                        android:drawableRight="?android:attr/listChoiceIndicatorSingle"/>
                </RadioGroup>
                <TextView
                    android:id="@+id/tvGenderError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/error_select_gender"
                    android:textColor="#B00020"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_age_title"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_primary"
                    android:layout_marginBottom="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/desc_age"
                    android:gravity="center"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_marginBottom="30dp"/>

                <EditText
                    android:id="@+id/etAge"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:background="@drawable/bg_input_outline"
                    android:hint="@string/hint_age"
                    android:gravity="center"
                    android:inputType="number"
                    android:textSize="24sp"/>
                <TextView
                    android:id="@+id/tvAgeError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/error_age_required"
                    android:textColor="#B00020"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="5dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_measurements_title"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_primary"
                    android:layout_marginBottom="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/desc_measurements"
                    android:gravity="center"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_marginBottom="30dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_weight"
                    android:textColor="@color/md_theme_onSurface"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"/>
                <EditText
                    android:id="@+id/etWeight"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/bg_input_outline"
                    android:hint="@string/label_weight"
                    android:inputType="numberDecimal"
                    android:paddingStart="20dp"/>
                <TextView
                    android:id="@+id/tvWeightError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/error_weight_required"
                    android:textColor="#B00020"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginBottom="15dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_height"
                    android:textColor="@color/md_theme_onSurface"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"/>
                <EditText
                    android:id="@+id/etHeight"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/bg_input_outline"
                    android:hint="@string/label_height"
                    android:inputType="number"
                    android:paddingStart="20dp"/>
                <TextView
                    android:id="@+id/tvHeightError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/error_height_required"
                    android:textColor="#B00020"
                    android:textSize="12sp"
                    android:visibility="gone"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_goal_title"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_primary"
                    android:layout_marginBottom="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/desc_goal"
                    android:gravity="center"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_marginBottom="30dp"/>

                <EditText
                    android:id="@+id/etGoalWeight"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:background="@drawable/bg_input_outline"
                    android:hint="@string/hint_goal_weight"
                    android:inputType="numberDecimal"
                    android:gravity="center"
                    android:textSize="24sp"/>
                <TextView
                    android:id="@+id/tvGoalError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/error_goal_weight_required"
                    android:textColor="#B00020"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_ready"
                    android:textColor="@color/md_theme_primary"
                    android:textStyle="bold"
                    android:layout_marginTop="30dp"/>
            </LinearLayout>

        </ViewFlipper>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:gravity="end">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/btn_back"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:background="@android:color/transparent"
            android:layout_marginEnd="20dp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:visibility="gone"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/btn_next"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_button_blue"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </LinearLayout>

</RelativeLayout>