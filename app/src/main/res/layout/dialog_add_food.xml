<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Food"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/etSearchFood"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="#F0F0F0"
            android:hint="Search (e.g. Apple)"
            android:paddingStart="16dp"
            android:textColor="@android:color/black"
            android:inputType="text" />

        <ImageButton
            android:id="@+id/btnScanBarcode"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="#E0E0E0"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Scan Barcode"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Suggestions / Results:"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginBottom="4dp"/>

    <ListView
        android:id="@+id/lvFoodResults"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:dividerHeight="1dp"
        android:divider="#EEEEEE"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Added Items:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/tvFoodLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No items added yet."
        android:textSize="14sp"
        android:padding="8dp"
        android:background="#F9F9F9"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Done"
        android:backgroundTint="#005BB1"
        android:textColor="@android:color/white"/>

</LinearLayout>