<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_background"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="32sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View and manage your account"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="14sp"
                android:alpha="0.6"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="24dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    app:cardBackgroundColor="@color/md_theme_primary"
                    app:cardCornerRadius="45dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/profileInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        tools:text="M"
                        android:textColor="@color/md_theme_onPrimary"
                        android:textSize="40sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/profileFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    tools:text="Mario Rossi"
                    android:textColor="@color/md_theme_onBackground"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profileEmailTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    tools:text="mario.rossi@email.com"
                    android:textColor="@color/md_theme_onBackground"
                    android:alpha="0.7"
                    android:textSize="16sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="@color/md_theme_secondaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:padding="16dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/txtKpiWorkouts" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="127" android:textSize="24sp" android:fontFamily="sans-serif-black"
                            android:textColor="@color/md_theme_onSecondaryContainer"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/workouts" android:textSize="10sp" android:alpha="0.8" android:textStyle="bold" android:textAllCaps="true"
                            android:textColor="@color/md_theme_onSecondaryContainer"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/txtKpiStreak" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="18" android:textSize="24sp" android:fontFamily="sans-serif-black"
                            android:textColor="@color/md_theme_onSecondaryContainer"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/streak" android:textSize="10sp" android:alpha="0.8" android:textStyle="bold" android:textAllCaps="true"
                            android:textColor="@color/md_theme_onSecondaryContainer"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/txtKpiVolume" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="2.5M" android:textSize="24sp" android:fontFamily="sans-serif-black"
                            android:textColor="@color/md_theme_onSecondaryContainer"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/volume" android:textSize="10sp" android:alpha="0.8" android:textStyle="bold" android:textAllCaps="true"
                            android:textColor="@color/md_theme_onSecondaryContainer"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="@color/md_theme_surfaceContainerHighest">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Account Details"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/md_theme_onSurface"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="12dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_email"
                            app:tint="@color/md_theme_primary"/>
                        <TextView
                            android:id="@+id/tvDetailEmail"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            tools:text="mario.rossi@email.com"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="15sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="12dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/person"
                            app:tint="@color/md_theme_primary"/>
                        <TextView
                            android:id="@+id/tvDetailGender"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            tools:text="Male"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="15sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="12dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/md_theme_primary"/>
                        <TextView
                            android:id="@+id/tvDetailAge"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            tools:text="28 years"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="15sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="12dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_height"
                            app:tint="@color/md_theme_primary"/>
                        <TextView
                            android:id="@+id/tvDetailHeight"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            tools:text="180 cm"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="15sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="12dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_weight"
                            app:tint="@color/md_theme_primary"/>
                        <TextView
                            android:id="@+id/tvDetailWeight"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            tools:text="80 kg"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="15sp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="32dp"
                android:text="Logout"
                android:textColor="@color/md_theme_error"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="22dp"
                app:iconTint="@color/md_theme_error"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/md_theme_errorContainer"
                android:letterSpacing="0.05" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>