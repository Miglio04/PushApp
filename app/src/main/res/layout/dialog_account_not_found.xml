<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="?attr/colorSurface"> <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <ImageView
        android:id="@+id/iconError"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_error_vector"
        app:tint="?attr/colorError" android:contentDescription="Error Icon"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Account Not Found"
        android:textColor="?attr/colorError" android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This email is not registered. Do you want to create a new account?"
        android:gravity="center"
        android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="REGISTER NOW"
        android:textColor="?attr/colorOnPrimary"
        android:backgroundTint="?attr/colorPrimary" android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/btnTryAgain"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="No, Try Again"
        android:gravity="center"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"/>

</LinearLayout>
</androidx.cardview.widget.CardView>