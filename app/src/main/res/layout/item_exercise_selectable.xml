<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/md_theme_surfaceContainerLow"
    app:cardCornerRadius="16dp"
    app:strokeWidth="0dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/text_exercise_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/md_theme_onSurface"
            android:ellipsize="end"
            android:maxLines="2"
            android:layout_marginEnd="12dp"
            tools:text="Dumbbell Bicep Curl" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_exercise_muscle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Widget.Material3.Chip.Assist"
            android:textSize="11sp"
            android:textColor="@color/md_theme_onTertiaryContainer"
            app:chipBackgroundColor="@color/md_theme_tertiaryContainer"
            app:chipCornerRadius="8dp"
            app:chipMinHeight="26dp"
            app:chipStartPadding="8dp"
            app:chipEndPadding="8dp"
            app:ensureMinTouchTargetSize="false"
            tools:text="Biceps"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>