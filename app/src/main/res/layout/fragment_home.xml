<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:background="@color/md_theme_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/nameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:text="@string/trattino"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="24sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/outline_local_fire_department_24"
                app:drawableTint="@color/md_theme_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/subTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ready_to_train"
                android:textColor="@color/md_theme_onBackground_mediumContrast"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/nameTitle" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/md_theme_secondaryContainer"
            app:strokeColor="@color/md_theme_primary"
            app:cardCornerRadius="30dp"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/lblWeight"
                        android:text="@string/weight_progress"
                        android:textColor="@color/md_theme_onSecondaryContainer"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"/>

                    <TextView
                        android:id="@+id/tvWeightVal"
                        android:text="@string/trattino"
                        android:textColor="@color/md_theme_onBackground"
                        android:textStyle="bold"
                        android:textSize="32sp"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/lblWeight"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"/>

                    <TextView
                        android:id="@+id/tvWeightDiff"
                        android:text="@string/trattino"
                        android:textColor="@color/md_theme_onSecondaryContainer"
                        android:textSize="14sp"
                        android:layout_marginStart="8dp"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvWeightVal"
                        app:layout_constraintStart_toEndOf="@id/tvWeightVal"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"/>

                    <TextView
                        android:text="@string/account_not_found"
                        android:textColor="@color/md_theme_onSecondary"
                        android:background="@drawable/bd_badge_purple"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"/>

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="20dp"
                        android:contentDescription="@string/progress_chart"
                        android:src="@drawable/ic_launcher_background"
                        app:tint="@color/md_theme_secondary"
                        app:layout_constraintTop_toBottomOf="@id/tvWeightVal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
           </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">
            <TextView
                android:id="@+id/tvPhrase1"
                android:gravity="center"
                android:text="@string/push_yourself_because_no_none_else_will"
                android:textColor="@color/md_theme_onBackground"
                android:shadowColor="@color/md_theme_primary"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="50"
                android:textStyle="bold"
                android:textSize="22sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvPhrase2"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/consistency_beats_talent"
            android:textColor="@color/md_theme_onBackground_mediumContrast"
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnAllenati"
                android:text="@string/train_now"
                android:textAllCaps="true"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_onSecondary"
                android:background="@drawable/btn_gradient"
                app:backgroundTint="@null"
                app:icon="@drawable/outline_local_fire_department_24"
                app:iconGravity="textStart"
                app:iconTint="@color/md_theme_onSecondary"
                android:layout_width="match_parent"
                android:padding="16dp"
                android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:weightSum="3"
            android:baselineAligned="false"
            android:orientation="horizontal">
                <include
                    android:id="@+id/cardStreak"
                    layout="@layout/item_home_stat_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"/>

                <include
                    android:id="@+id/cardWorkouts"
                    layout="@layout/item_home_stat_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"/>

                <include
                    android:id="@+id/cardVolume"
                    layout="@layout/item_home_stat_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
