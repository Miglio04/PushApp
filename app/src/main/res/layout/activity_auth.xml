<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- 1. LOGO E TITOLO (Fissi in alto) -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"

        android:layout_marginTop="80dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo_pushapp"
            android:contentDescription="App Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PushApp"

            android:textSize="32sp"

            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:layout_marginTop="8dp"/>

        <!-- NUOVA SCRITTA GRIGIA DINAMICA -->
        <TextView
            android:id="@+id/tvAuthSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome back!"
            android:textColor="#757575"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- 2. LO SWITCH (TabLayout) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutAuth"
        android:layout_width="match_parent"
        android:layout_height="60dp"

        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="24dp"

        android:background="@drawable/bg_switch_container"

        app:tabIndicator="@drawable/bg_switch_indicator"
        app:tabIndicatorGravity="stretch"
        app:tabIndicatorColor="@null"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorFullWidth="true"

        app:tabSelectedTextColor="@android:color/white"
        app:tabTextColor="@color/md_theme_primary"

        app:tabRippleColor="@null"
        app:tabTextAppearance="@style/MyTabTextStyle"

        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.tabs.TabItem
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Accedi" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Registrati" />

    </com.google.android.material.tabs.TabLayout>

    <!-- 3. IL CONTENITORE DEI FRAGMENT -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"

        android:background="@android:color/white"

        app:defaultNavHost="true"
        app:navGraph="@navigation/auth_nav_graph"

        app:layout_constraintTop_toBottomOf="@id/tabLayoutAuth"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
