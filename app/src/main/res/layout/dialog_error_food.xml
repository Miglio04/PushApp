<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:id="@+id/iconError"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_error_vector"
            app:tint="#D32F2F"
            android:contentDescription="@string/desc_error_icon"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_food_not_found"
            tools:text="Food Not Found"
            android:textColor="#D32F2F"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/desc_food_not_found"
            tools:text="We couldn't find this item. Try searching in English."
            android:gravity="center"
            android:textColor="#757575"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnErrorOk"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:text="@string/btn_try_again_short"
            tools:text="TRY AGAIN"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_button_blue"
            app:backgroundTint="@null"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/btnErrorCancel"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/cancel"
            tools:text="Cancel"
            android:gravity="center"
            android:textColor="#757575"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>