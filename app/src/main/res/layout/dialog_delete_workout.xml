<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/md_theme_surfaceContainerHigh">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <!-- Icona -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:cardCornerRadius="36dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/md_theme_error"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/iconError"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/delete"
                android:contentDescription="@null"
                app:tint="@color/md_theme_onError"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Titolo -->
        <TextView
            android:id="@+id/tvDeleteTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="10dp"
            tools:text="Delete Workout"/>

        <!-- Messaggio -->
        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="24dp"
            tools:text="Are you sure you want to delete this session?"/>

        <!-- Pulsante Delete -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnErrorOk"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:textColor="@color/md_theme_onError"
            android:textSize="15sp"
            app:backgroundTint="@color/md_theme_error"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="14dp"
            android:layout_marginBottom="10dp"
            tools:text="Delete"/>

        <!-- Pulsante Cancel -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnErrorCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:strokeColor="@color/md_theme_outlineVariant"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            tools:text="Cancel"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
