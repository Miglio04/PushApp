<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Arrotondamento massimo per effetto pillola -->
    <corners android:radius="50dp" />

    <!-- Sfondo BIANCO -->
    <solid android:color="@android:color/white" />

    <!-- Bordo (Outline) -->
    <!-- Se @color/md_theme_outline risulta troppo scuro, prova questo grigio chiaro standard (#E0E0E0) -->
    <!-- Se invece vuoi ESATTAMENTE quello di input, apri bg_input_outline.xml e copia il colore che c'è lì dentro -->
    <stroke
        android:width="1dp"
        android:color="#E0E0E0"/>
</shape>
