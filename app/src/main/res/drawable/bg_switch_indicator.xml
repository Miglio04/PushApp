<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Questo serve per dare un po' di margine alla pillola interna in modo che non tocchi i bordi -->
    <item
        android:top="4dp"
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp">

        <shape android:shape="rectangle">
            <corners android:radius="50dp" />
            <solid android:color="@color/md_theme_primaryContainer" /> <!-- IL TUO COLORE BLU -->
            <!-- Ombra leggera per dare profondità -->
            <padding android:bottom="2dp"/>
        </shape>
    </item>
</layer-list>
